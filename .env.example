NEXT_PUBLIC_APP_URL=https://app.aioboost.jp

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_SEARCH_MODEL=gpt-6-luna

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=info@aioboost.jp
SENDGRID_FROM_NAME=AIO boost
ADMIN_NOTIFICATION_EMAIL=
APP_BASE_URL=https://app.aioboost.jp
# SendGrid Inbound Parse / reverse proxy must authenticate every request with this server-only secret.
INBOUND_EMAIL_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.aioboost.jp/api/google/oauth/callback
# Production review default: openid email profile business.manage
# Staging may explicitly add gmail.compose and calendar.events for isolated testing.
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/business.manage
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Meta OAuth for Facebook Page and Instagram professional account publishing.
# Production callback: https://app.aioboost.jp/api/meta/oauth/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://app.aioboost.jp/api/meta/oauth/callback
META_GRAPH_VERSION=v23.0
SNS_TOKEN_ENCRYPTION_KEY=

# Instagram Login is separate from Facebook Login. Never reuse META_APP_SECRET as this app secret.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://app.aioboost.jp/api/instagram/oauth/callback
INSTAGRAM_GRAPH_VERSION=v26.0
# Reuse the stable SNS_TOKEN_ENCRYPTION_KEY when no dedicated encryption key is configured.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_LOGIN_ENABLED=false
# Only set true after both Instagram Login permissions receive Advanced Access and the app is live.
INSTAGRAM_ADVANCED_ACCESS_APPROVED=false
# Before approval, explicitly authorized isolated review/test stores only (comma-separated UUIDs).
INSTAGRAM_LOGIN_TEST_STORE_IDS=

# LINE Official Account / Messaging API. Values are managed in Vercel and must never be committed.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OFFICIAL_ACCOUNT_BASIC_ID=@056miwxi

# Store-side Stripe Connect. Values are managed in Vercel and must never be committed.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_REDIRECT_URI=https://app.aioboost.jp/api/stripe/oauth/callback
STRIPE_ACCOUNT_LINK_RETURN_URL=https://app.aioboost.jp
STRIPE_ACCOUNT_LINK_REFRESH_URL=https://app.aioboost.jp
STRIPE_WEBHOOK_SECRET=
STRIPE_TOKEN_ENCRYPTION_KEY=

# Store-side freee accounting OAuth. Values are managed in Vercel and must never be committed.
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
FREEE_REDIRECT_URI=https://app.aioboost.jp/api/freee/oauth/callback
FREEE_TOKEN_ENCRYPTION_KEY=
